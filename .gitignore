# 运行时产物 / 本地密钥，一律不入库
__pycache__/
*.py[cod]
build/
tools/*.spec
tools/antipole-relay/dist/

# 编译产物与安装包（源码在 tools/，按 README 自行构建）
tools/antipole-relay/bin/
dist/*.exe
dist/*.msi

# 线上真实配置与备份（含管理令牌、公网地址，严禁提交）
config.yaml
config-bak-*.yaml
config-*.polluted*

# 客户端证书与本地配置（含私钥/令牌）
dist/certs/
dist/*.json
certs/

# 日志与临时诊断脚本
*.log
_*.py
deploy/local*
